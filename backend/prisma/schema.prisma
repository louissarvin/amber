// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "./generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector, pgcrypto]
}

model User {
  id            String    @id @default(cuid())
  walletAddress String    @unique
  nonce         String? // For signature verification
  lastSignIn    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model ErrorLog {
  id         String   @id @default(cuid())
  errorCode  String
  message    String
  statusCode Int
  stack      String?  @db.Text
  context    String?  @db.Text
  userId     String?
  method     String?
  path       String?
  userAgent  String?  @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  @@index([errorCode])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// AMBER models
// -----------------------------------------------------------------------------
//
// MANUAL SQL — must run once against the database BEFORE `bun run db:push`.
// See prisma/bootstrap.sql for the full statements. Quick reference:
//
//   -- UP (before db:push)
//   CREATE EXTENSION IF NOT EXISTS vector;
//   CREATE EXTENSION IF NOT EXISTS pgcrypto;
//
//   -- AFTER db:push:
//   CREATE INDEX CONCURRENTLY IF NOT EXISTS "memory_embedding_ivfflat_idx"
//     ON "Memory" USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);
//   CREATE INDEX CONCURRENTLY IF NOT EXISTS "memory_active_identity_created_idx"
//     ON "Memory" ("identityId", "createdAt" DESC) WHERE "deletedAt" IS NULL;
//
//   -- DOWN (reversal)
//   DROP INDEX CONCURRENTLY IF EXISTS "memory_active_identity_created_idx";
//   DROP INDEX CONCURRENTLY IF EXISTS "memory_embedding_ivfflat_idx";
//   DROP EXTENSION IF EXISTS vector;
//
// USER WORKFLOW:
//   1. Run prisma/bootstrap.sql via psql on your Postgres (Neon SQL editor works).
//   2. `bun run db:push`
//   3. Run the CONCURRENTLY index statements from bootstrap.sql
// -----------------------------------------------------------------------------

enum MemoryCategory {
  preference
  fact
  event
  relationship
  task
  note
  system
}

enum AttestationStatus {
  pending
  submitted
  attested
  failed
}

enum SignerMode {
  tee
  self
}

enum SubscriptionStatus {
  open
  expired
  closed
  revoked
}

enum SealSigilStyle {
  amber
  onyx
  cream
}

model Identity {
  id         String    @id @default(cuid())
  address    String    @unique // lowercased 0x + 40 hex, ERC-8004 address
  agentId    String?
  reputation Int?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  memories        Memory[]
  quota           Quota?
  paymentReceipts PaymentReceipt[]
  attestations    Attestation[]
  mcpSessions     McpSession[]
  subscriptions   Subscription[]
  seals           Seal[]

  @@index([address])
  @@index([agentId])
}

model Memory {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  content     String         @db.Text
  contentHash Bytes
  category    MemoryCategory @default(note)
  tags        String[]       @default([])
  metadata    Json           @default("{}")
  clientNonce String?

  embedding Unsupported("vector(1024)")?

  attestationId String?
  attestation   Attestation? @relation(fields: [attestationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([identityId, clientNonce], name: "identity_client_nonce_unique")
  @@index([identityId, createdAt])
  @@index([identityId, category])
  @@index([attestationId])
}

model Attestation {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  merkleRoot    Bytes
  status        AttestationStatus @default(pending)
  signerMode    SignerMode        @default(tee)
  signerAddress String?
  txHash        String?           @unique
  // Records the last broadcast tx hash even if tx.wait() timed out. Enables
  // attestationRetry to check the receipt on-chain before resubmitting.
  // -- UP: `db:push` will add nullable column `lastTxHash TEXT`.
  // -- DOWN: `ALTER TABLE "Attestation" DROP COLUMN "lastTxHash";`
  lastTxHash    String?
  chainId       Int               @default(196)
  retries       Int               @default(0)
  lastError     String?           @db.Text

  submittedAt DateTime?
  attestedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memories Memory[]
  leaves   AttestationLeaf[]
  seals    Seal[]

  @@index([status, createdAt])
  @@index([identityId])
  @@index([merkleRoot])
}

model AttestationLeaf {
  id            String      @id @default(cuid())
  attestationId String
  attestation   Attestation @relation(fields: [attestationId], references: [id], onDelete: Cascade)

  memoryId  String
  leafHash  Bytes
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attestationId, position])
  @@index([memoryId])
}

model Quota {
  id         String   @id @default(cuid())
  identityId String   @unique
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  freeUsed        Int    @default(0)
  paidWrites      BigInt @default(0)
  paidQueries     BigInt @default(0)
  totalPaidAtomic BigInt @default(0)

  subscriptionId           String?
  subscriptionExpiresAt    DateTime?
  subscriptionBudgetAtomic BigInt?
  subscriptionSpentAtomic  BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId])
}

model PaymentNonce {
  id          String   @id @default(cuid())
  nonce       Bytes    @unique
  fromAddress String
  chainId     Int      @default(196)
  usedAt      DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([fromAddress])
  @@index([expiresAt])
}

model PaymentReceipt {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  endpoint       String
  scheme         String
  amountAtomic   BigInt
  payer          String
  nonce          Bytes?    @unique
  authorization  Json
  signature      String
  chainId        Int       @default(196)
  txHash         String?   @unique
  memoryId       String?
  settledAt      DateTime?
  // Maximize Sprint 2026-07-14 — on-chain settler bookkeeping.
  // -- UP: `db:push` adds nullable columns `settleAttempts INT DEFAULT 0`,
  //         `settleError TEXT`, `chainId INT DEFAULT 196`.
  // -- DOWN: `ALTER TABLE "PaymentReceipt" DROP COLUMN "settleAttempts",
  //         DROP COLUMN "settleError", DROP COLUMN "chainId";`
  settleAttempts Int       @default(0)
  settleError    String?   @db.Text

  // Continuation Sprint 2026-07-14 — track how a receipt was authorized.
  // "exact" = classic EIP-3009 per-request; "period" = x402 subscription
  // debit (no on-chain settle needed); "free" = free-tier bookkeeping row.
  // -- UP: `db:push` adds `mode TEXT DEFAULT 'exact'`, `subscriptionId TEXT`.
  // -- DOWN: `ALTER TABLE "PaymentReceipt" DROP COLUMN "mode",
  //          DROP COLUMN "subscriptionId";`
  mode           String  @default("exact")
  subscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId, createdAt])
  @@index([payer])
  @@index([txHash])
  @@index([settledAt, settleAttempts])
  @@index([subscriptionId])
}

// -----------------------------------------------------------------------------
// Maximize Sprint 2026-07-14 — Subscription (x402 `period` scheme)
// -- UP: new tables created by `bun run db:push`.
// -- DOWN: DROP TABLE "Subscription"; DROP TYPE "SubscriptionStatus";
// -----------------------------------------------------------------------------
model Subscription {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  permit2Nonce  Bytes              @unique // 32 bytes
  budgetAtomic  BigInt
  spentAtomic   BigInt             @default(0)
  periodSeconds Int
  status        SubscriptionStatus @default(open)

  openedAt  DateTime  @default(now())
  expiresAt DateTime
  closedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([identityId, status])
  @@index([expiresAt])
}

// -----------------------------------------------------------------------------
// Maximize Sprint 2026-07-14 — Seal (SEALSCRIBE-lite output)
// -- UP: new table created by `bun run db:push`.
// -- DOWN: DROP TABLE "Seal"; DROP TYPE "SealSigilStyle";
// -----------------------------------------------------------------------------
model Seal {
  id         String   @id @default(cuid())
  identityId String
  identity   Identity @relation(fields: [identityId], references: [id], onDelete: Restrict)

  subject       String
  decreeText    String         @db.Text
  sigilStyle    SealSigilStyle @default(amber)
  svgPath       String
  pngPath       String?
  attestationId String?
  attestation   Attestation?   @relation(fields: [attestationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([identityId, createdAt])
  @@index([attestationId])
}

model McpSession {
  id         String    @id
  identityId String?
  identity   Identity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  origin          String
  protocolVersion String
  clientName      String?
  clientVersion   String?
  expiresAt       DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identityId])
  @@index([expiresAt])
}
